# LLM provider: nebius (default) or openai.
AI_PROVIDER=nebius

# Nebius Token Factory — required when AI_PROVIDER=nebius
NEBIUS_API_KEY=your-nebius-api-key

# OpenAI — required when AI_PROVIDER=openai; can also power transcription.
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_CLAIM_MODEL=gpt-4.1-mini
# OPENAI_RESEARCH_MODEL=gpt-4.1-mini
# OPENAI_STT_MODEL=gpt-4o-transcribe

# Speech-to-text: auto (default), openai, groq, or browser.
# auto prefers OpenAI when OPENAI_API_KEY is set, then Groq, then browser speech.
STT_PROVIDER=auto
# GROQ_API_KEY=your-groq-api-key

# Tavily web search — required by the fact-checking app.
TAVILY_API_KEY=your-tavily-api-key
